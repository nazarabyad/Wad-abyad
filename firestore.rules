rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    match /orders/{id} {
      function admin(){ return request.auth != null && request.auth.token.email == 'ADMIN_EMAIL_HERE'; }
      allow create: if request.resource.data.st == 'new' && request.resource.data.items.size() > 0 && request.resource.data.total is number;
      allow get: if true;
      allow list, delete: if admin();
      allow update: if admin() || (resource.data.st == 'confirmed'
        && request.resource.data.st == 'paid'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','pay','ref']));
    }
  }
}
