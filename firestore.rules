rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    function admin(){ return request.auth != null && request.auth.token.email == 'ADMIN_EMAIL_HERE'; }
    function driver(){ return request.auth != null && request.auth.token.email == 'DRIVER_EMAIL_HERE'; }
    match /orders/{id} {
      allow create: if request.resource.data.st == 'new' && request.resource.data.items.size() > 0 && request.resource.data.total is number;
      allow get: if true;
      allow list: if admin() || driver();
      allow delete: if admin();
      allow update: if admin()
        || (resource.data.st == 'confirmed' && request.resource.data.st == 'paid'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','pay','rc','payNote']))
        || (resource.data.st == 'adjust' && request.resource.data.st in ['new','cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st']))
        || (driver() && resource.data.st == 'ready' && request.resource.data.st == 'out'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st']))
        || (driver() && resource.data.st == 'out' && request.resource.data.st == 'done'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st']));
    }
    match /receipts/{id} {
      allow create, update: if request.resource.data.keys().hasOnly(['img'])
        && request.resource.data.img is string && request.resource.data.img.size() < 700000
        && get(/databases/$(d)/documents/orders/$(id)).data.st == 'confirmed';
      allow get, delete: if admin();
    }
    match /config/{x} {
      allow get: if true;
      allow write: if admin();
    }
  }
}
